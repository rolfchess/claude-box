{
  "permissions": {
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*.{json,yaml,yml,env,txt,conf,properties})"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/check-forbidden-words.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "statusMessage": "Checking writing style"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/check-review-notes.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 10,
            "statusMessage": "Checking the note"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/git/check-commit-message.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 10,
            "statusMessage": "Checking the commit message"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/scan-changed-files.py\"; [ -f \"$f\" ] && exec python3 \"$f\" --mode=bash; exit 0",
            "timeout": 15,
            "statusMessage": "Checking writing style"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/inject-rules.py\"; [ -f \"$f\" ] && exec python3 \"$f\" --mode=batch; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/inject-rules.py\"; [ -f \"$f\" ] && exec python3 \"$f\" --mode=prompt; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/inject-rules.py\"; [ -f \"$f\" ] && exec python3 \"$f\" --mode=compact; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/scan-changed-files.py\"; [ -f \"$f\" ] && exec python3 \"$f\" --mode=stop; exit 0",
            "timeout": 15,
            "statusMessage": "Checking writing style"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/check-prose-style.py\"; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0",
            "timeout": 300,
            "async": true,
            "asyncRewake": true,
            "statusMessage": "Reading the changed prose"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/scripts/writing-style/scan-changed-files.py\"; [ -f \"$f\" ] && exec python3 \"$f\" --mode=stop; exit 0",
            "timeout": 15,
            "statusMessage": "Checking writing style"
          }
        ]
      }
    ]
  }
}
